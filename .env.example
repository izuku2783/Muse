APP_NAME=Muse
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
MUSICBRAINZ_USER_AGENT=Muse/0.1.0 (replace-with-project-contact)

DATABASE_URL=postgresql+psycopg://muse:muse_password@localhost:5432/muse

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=muse_knowledge
QDRANT_API_KEY=

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_VERSION=fastembed-0.8.1-query-passage-v1
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=data/models

RERANKER_PROVIDER=fastembed
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_VERSION=fastembed-0.8.1
RERANKER_CACHE_DIR=data/models
RERANKER_BATCH_SIZE=32

LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_COMPLETION_TOKENS=1024
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

AGENT_MAX_ITERATIONS=2
AGENT_MAX_TOOL_CALLS=2
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_EVIDENCE=5
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_ACTIVE=1000

# Optional Spotify PKCE integration. Keep the generated encryption key only in .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/integrations/spotify/callback
SPOTIFY_TOKEN_ENCRYPTION_KEY=
SPOTIFY_HTTP_TIMEOUT_SECONDS=10
SPOTIFY_OAUTH_STATE_TTL_SECONDS=600

PERSONALIZATION_RELEVANCE_WEIGHT=0.5
PERSONALIZATION_PREFERENCE_WEIGHT=0.2
PERSONALIZATION_NOVELTY_WEIGHT=0.15
PERSONALIZATION_DIVERSITY_WEIGHT=0.15
PERSONALIZATION_SPOTIFY_SIGNAL_LIMIT=20
